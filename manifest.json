{
  "manifest_version": 3,
  "name": "QuickLaunch",
  "version": "1.1",
  "description": "Quick access to your favorite websites.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  }
}