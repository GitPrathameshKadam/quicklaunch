{
  "manifest_version": 3,
  "name": "QuickLaunch",
  "version": "2.6",
  "description": "Save and launch website shortcuts, organize workspaces, and copy reusable snippets from the toolbar.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open QuickLaunch"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "notifications",
    "tabGroups",
    "favicon",
    "clipboardWrite"
  ],
  "optional_permissions": [
    "clipboardRead"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' data:; connect-src 'none'; media-src 'none'; frame-src 'none'; style-src 'self' 'unsafe-inline'"
  }
}
